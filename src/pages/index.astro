---
import Layout from '../layouts/Layout.astro';

// Work-in-progress holding page. The full homepage (hero / tjenester / om /
// kontakt) is parked in git history at a1b31c9 and goes back up once the copy,
// the brand mark and the company registration are settled.
---

<Layout title="Lokalverket" description="Lokalverket - nettstedet er under arbeid.">
  <main>
    <p class="eyebrow">Under arbeid</p>
    <h1 class="wordmark"><span class="lokal">lokal</span><span class="verket">verket</span></h1>
    <p class="status">Nettstedet er under arbeid. Innholdet er ikke klart ennå.</p>
    <p class="contact">
      <a href="mailto:post@lokalverket.no">post@lokalverket.no</a>
    </p>
  </main>
</Layout>

<style>
  main {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    text-align: center;
    padding: var(--space-8) var(--space-6);
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .wordmark {
    margin: 0;
    font-family: var(--font-wordmark);
    font-size: var(--text-4xl);
    font-weight: 400;
    line-height: 1;
  }

  .wordmark .lokal {
    color: var(--grey-500);
    font-weight: 300;
  }

  .wordmark .verket {
    color: var(--paper);
    font-weight: 700;
  }

  .status {
    margin: 0;
    max-width: var(--measure);
    color: var(--grey-300);
    font-size: var(--text-base);
  }

  .contact {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
  }

  .contact a {
    color: var(--color-link);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }

  .contact a:hover {
    color: var(--paper);
  }
</style>
